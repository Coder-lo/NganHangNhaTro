@model IEnumerable<Category>
@{ ViewData["Title"] = "Quản lý danh mục"; }
<h1>Quản lý danh mục</h1>
<form asp-action="AddCategory" method="post" class="inline-create">@Html.AntiForgeryToken()<input name="categoryName" required maxlength="150" placeholder="Tên danh mục mới"/><select name="type"><option value="Location">Khu vực</option><option value="RoomType">Loại phòng</option></select><button class="btn btn-primary">Thêm danh mục</button></form>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Tên danh mục</th><th>Loại</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var c in Model) { <tr><td>@c.CategoryId</td><td>@c.CategoryName</td><td>@(c.Type == "Location" ? "Khu vực" : "Loại phòng")</td><td><form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Xóa danh mục này?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.CategoryId"/><button class="btn btn-small btn-danger">Xóa</button></form></td></tr> }
</tbody></table></div>
