@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="form-page"><span class="eyebrow">BẢO MẬT</span><h1>Đổi mật khẩu</h1><form asp-action="ChangePassword" method="post" class="form-stack">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="validation"></span><label asp-for="NewPassword">Mật khẩu mới (ít nhất 8 ký tự)</label><input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="validation"></span><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation"></span><button class="btn btn-primary full" type="submit">Cập nhật mật khẩu</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
