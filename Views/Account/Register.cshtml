@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="auth-card"><h1>Tạo tài khoản</h1><p class="muted">Tham gia Ngân hàng nhà trọ</p>
<form asp-action="Register" method="post" class="form-stack">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="FullName">Họ và tên</label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="validation"></span>
    <label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="validation"></span>
    <label asp-for="PhoneNumber">Số điện thoại</label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="validation"></span>
    <label asp-for="Password">Mật khẩu (ít nhất 8 ký tự)</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="validation"></span>
    <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span>
    <label asp-for="Role">Bạn là</label><select asp-for="Role"><option value="Tenant">Người thuê</option><option value="Landlord">Chủ trọ</option></select>
    <button class="btn btn-primary full" type="submit">Đăng ký</button>
</form><p class="auth-foot">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
