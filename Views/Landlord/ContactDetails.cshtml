@model Contact
@{ ViewData["Title"] = "Chi tiết yêu cầu xem phòng"; }
<div class="form-page"><span class="eyebrow">CHỦ TRỌ · YÊU CẦU LIÊN HỆ #@Model.ContactId</span><h1>@Model.Room?.Title</h1><p class="muted">Nhận lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p><div class="detail-facts"><span>Họ tên: <b>@Model.SenderName</b></span><span>Điện thoại: <b>@Model.SenderPhone</b></span><span>Email: <b>@(Model.SenderEmail ?? "Chưa cung cấp")</b></span></div><h3>Lời nhắn của khách</h3><p class="description">@(string.IsNullOrWhiteSpace(Model.Message) ? "Khách không để lại lời nhắn." : Model.Message)</p><div class="quick-links"><a class="btn btn-outline" asp-action="Contacts">Quay lại danh sách</a><a class="btn btn-primary" href="tel:@Model.SenderPhone">Gọi người liên hệ</a></div></div>
