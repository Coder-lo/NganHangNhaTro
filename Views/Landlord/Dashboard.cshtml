@{ ViewData["Title"] = "Tổng quan chủ trọ"; var recent = ViewBag.RecentRooms as List<Room> ?? new(); }
<div class="section-heading"><div><span class="eyebrow">KHU VỰC CHỦ TRỌ</span><h1>Tổng quan hoạt động</h1><p class="muted">Theo dõi tin đăng và yêu cầu liên hệ của bạn.</p></div><a class="btn btn-primary" asp-action="Create">+ Đăng phòng mới</a></div>
<div class="stats-grid"><div class="stat-card"><span>Tổng tin đăng</span><strong>@ViewBag.Total</strong><a asp-action="Mine">Quản lý tin →</a></div><div class="stat-card warning-stat"><span>Chờ duyệt</span><strong>@ViewBag.Pending</strong></div><div class="stat-card"><span>Đang hiển thị</span><strong>@ViewBag.Approved</strong></div><div class="stat-card"><span>Đã cho thuê</span><strong>@ViewBag.Rented</strong></div><div class="stat-card"><span>Yêu cầu liên hệ</span><strong>@ViewBag.Contacts</strong><a asp-action="Contacts">Xem yêu cầu →</a></div></div>
<div class="section-heading"><h2>Tin đăng gần đây</h2><a asp-action="Mine">Xem tất cả</a></div>
@if (!recent.Any()) { <div class="empty-state"><h3>Bạn chưa có tin đăng</h3><p>Đăng phòng đầu tiên để bắt đầu kết nối với người thuê.</p><a class="btn btn-primary" asp-action="Create">Đăng tin ngay</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Tin đăng</th><th>Giá thuê</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var room in recent){<tr><td><b>@room.Title</b><div class="muted">@room.Address</div></td><td>@room.Price.ToString("N0") đ/tháng</td><td><span class="status @room.Status.ToLowerInvariant()">@(room.Status == "Pending" ? "Chờ duyệt" : room.Status == "Approved" ? "Đã duyệt" : room.Status == "Rejected" ? "Bị từ chối" : "Đã cho thuê")</span></td><td><a class="btn btn-small btn-outline" asp-action="Edit" asp-route-id="@room.RoomId">Sửa tin</a></td></tr>}</tbody></table></div> }
