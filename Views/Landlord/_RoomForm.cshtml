@model RoomFormViewModel
<div asp-validation-summary="ModelOnly" class="validation"></div>
<input type="hidden" asp-for="RoomId" />
<label asp-for="Title">Tiêu đề</label><input asp-for="Title" /><span asp-validation-for="Title" class="validation"></span>
<div class="form-row"><div><label asp-for="Price">Giá thuê (VNĐ/tháng)</label><input asp-for="Price" type="number" min="0" step="1000" /><span asp-validation-for="Price" class="validation"></span></div>
<div><label asp-for="Area">Diện tích (m²)</label><input asp-for="Area" type="number" min="0.1" step="0.1" /><span asp-validation-for="Area" class="validation"></span></div></div>
<div class="form-row"><div><label asp-for="ElectricityPrice">Giá điện (đ/kWh)</label><input asp-for="ElectricityPrice" type="number" min="0" step="100" /></div><div><label asp-for="WaterPrice">Giá nước (đ/m³)</label><input asp-for="WaterPrice" type="number" min="0" step="100" /></div></div>
<div><label asp-for="ServiceFee">Phí dịch vụ/mạng (đ/tháng)</label><input asp-for="ServiceFee" type="number" min="0" step="1000" /></div>
<label asp-for="Address">Địa chỉ</label><input asp-for="Address" /><span asp-validation-for="Address" class="validation"></span>
<div class="form-row"><div><label asp-for="LocationCategoryId">Khu vực</label><select asp-for="LocationCategoryId"><option value="">-- Chọn khu vực --</option>@foreach (var c in (ViewBag.LocationCategories as List<Category> ?? new())) { <option value="@c.CategoryId">@c.CategoryName</option> }</select><span asp-validation-for="LocationCategoryId" class="validation"></span></div><div><label asp-for="RoomTypeCategoryId">Loại phòng</label><select asp-for="RoomTypeCategoryId"><option value="">-- Chọn loại phòng --</option>@foreach (var c in (ViewBag.RoomTypeCategories as List<Category> ?? new())) { <option value="@c.CategoryId">@c.CategoryName</option> }</select><span asp-validation-for="RoomTypeCategoryId" class="validation"></span></div></div>
<label asp-for="Amenities">Tiện ích (phân cách bằng dấu phẩy)</label><input asp-for="Amenities" placeholder="Điều hòa, nóng lạnh, ban công, chỗ để xe..." maxlength="500" />
<label asp-for="Description">Mô tả</label><textarea asp-for="Description" rows="5" maxlength="4000"></textarea>
@if (!string.IsNullOrEmpty(Model.ExistingImageUrl)) { <img class="form-image-preview" src="@Model.ExistingImageUrl" alt="Ảnh phòng hiện tại" /> }
<label asp-for="ImageFile">Ảnh đại diện (JPG/PNG/WEBP, tối đa 5MB)</label><input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
<label asp-for="ImageFiles">Ảnh bổ sung (có thể chọn nhiều ảnh, mỗi ảnh tối đa 5MB)</label><input asp-for="ImageFiles" type="file" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
<button class="btn btn-primary full" type="submit">Lưu tin đăng</button>
