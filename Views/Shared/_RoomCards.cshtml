@model IEnumerable<Room>
@if (!Model.Any()) { <div class="empty-state">Không tìm thấy phòng trọ phù hợp. Hãy thử thay đổi bộ lọc.</div> }
else {
<div class="room-grid">
@foreach (var room in Model) {
    <article class="room-card">
        <a class="room-image" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId">
            @if (!string.IsNullOrWhiteSpace(room.ImageUrl)) { <img src="@room.ImageUrl" alt="@room.Title" loading="lazy" /> }
            else if (room.Images.FirstOrDefault() is { } firstImage) { <img src="@firstImage.ImageUrl" alt="@room.Title" loading="lazy" /> }
            else { <div class="image-placeholder">🏠</div> }
        </a>
        <div class="room-card-body">
            <span class="category-tag">@(room.RoomTypeCategory?.CategoryName ?? room.Category?.CategoryName)</span>
            @if (room.LocationCategory != null) { <span class="muted">📍 @room.LocationCategory.CategoryName</span> }
            <h3><a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId">@room.Title</a></h3>
            <div class="price">@room.Price.ToString("N0") đ <small>/ tháng</small></div>
            <p class="muted">📍 @room.Address</p>
            <div class="room-meta"><span>📐 @room.Area m²</span><span>👤 @room.Landlord?.FullName</span></div>
            <a class="btn btn-primary full" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId">Xem chi tiết</a>
        </div>
    </article>
}
</div>
}
