@model Contact
@{ ViewData["Title"] = "Chi tiết yêu cầu liên hệ"; }
<div class="form-page"><span class="eyebrow">YÊU CẦU LIÊN HỆ #@Model.ContactId</span><h1>@Model.Room?.Title</h1><p class="muted">Gửi lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p><div class="detail-facts"><span>Người gửi: <b>@Model.SenderName</b></span><span>Điện thoại: <b>@Model.SenderPhone</b></span><span>Email: <b>@(Model.SenderEmail ?? "Chưa cung cấp")</b></span></div><h3>Lời nhắn</h3><p class="description">@(string.IsNullOrWhiteSpace(Model.Message) ? "Không có lời nhắn." : Model.Message)</p><a class="btn btn-outline" asp-action="Mine">Quay lại danh sách</a><a class="btn btn-primary" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId">Xem phòng</a></div>
